{
  "name": "@openmahjong/engine",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Deterministic mahjong rules, scoring, payments and variant adapters; no runtime dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy/v1": {
      "types": "./dist/legacy/v1/index.d.ts",
      "import": "./dist/legacy/v1/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "files": [
    "dist",
    "src",
    "vendor"
  ]
}
