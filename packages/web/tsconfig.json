{
  "compilerOptions": {
    "declaration": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "dist",
    "paths": {
      "@openmahjong/ai": [
        "../ai/src/index.ts"
      ],
      "@openmahjong/engine": [
        "../engine/src/index.ts"
      ],
      "@openmahjong/coach": [
        "../coach/src/index.ts"
      ],
      "@openmahjong/engine/legacy/v1": [
        "../engine/src/legacy/v1/index.ts"
      ]
    },
    "sourceMap": false,
    "resolveJsonModule": true,
    "types": []
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
